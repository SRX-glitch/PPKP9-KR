# ROM 이미지·빌드 산출물 (저작권 + 용량: builds/ 만 13.8GB)
builds/
*.nds
*.srl

# 세이브·세이브스테이트
*.sav
*.dsv
*.dst
_states_*/
_save_backup_*/

# 백업 스냅샷 폴더
_backup_*/
_translation_backup_*/

# 대용량 조사 덤프 (rom_text.tsv 101MB — GitHub 100MB 제한 초과, ROM에서 재생성 가능)
# 단, 빌드가 읽는 워크리스트·폰트 배치·폭 표는 추적한다(재현성).
survey/*
!survey/common/
!survey/font/
survey/font/*.png
survey/font/_*.txt
!survey/ov28/
survey/ov28/*
!survey/ov28/opcode_lengths.json

# GitHub Release 업로드 스테이징 (upload_build.py 산출물 — 릴리스에 이미 있음)
release/_gh/

# 파이썬 캐시
__pycache__/
*.pyc

# 임시 파일
*.tmp
*.bak
~$*

# 타사 도구 디컴파일 소스 (PokeTEXT, © インデゴ) — 공개 저장소에 올리지 않음, 로컬 참고용
poketext_src/
