# ROM 이미지·빌드 산출물 (저작권 + 용량: builds/ 만 13.8GB)
builds/
*.nds
*.srl

# 세이브·세이브스테이트
*.sav
*.dsv
*.dst
_states_*/
_save_backup_*/

# 백업 스냅샷 폴더
_backup_*/
